# Copy to .env (never commit .env). Django does not auto-load this file:
#   set -a; source .env; set +a     (local)     |     env_file in compose.yaml (Docker)

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-any-shared-environment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Only needed behind HTTPS for /admin/ (full origins, comma-separated), e.g. https://api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Origins allowed to call the API from a browser (comma-separated). Default in DEBUG: Expo web (8081) and the wholesaler portal (5173).
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=dukalink
POSTGRES_USER=dukalink
POSTGRES_PASSWORD=dukalink
# The Postgres started by compose.yaml is published on 5434. Use 5432 for a PostgreSQL you installed yourself.
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Provisional business settings (see decisions.md)
ALLOW_NEGATIVE_STOCK=false
DEFAULT_PHONE_COUNTRY_CODE=254
DEFAULT_CURRENCY=KES
AUTH_THROTTLE_RATE=10/min
# Wholesalers must be verified by a platform admin before shops see their offers.
SUPPLIER_VERIFICATION_REQUIRED=true
LOG_LEVEL=INFO
# DB_ENGINE=sqlite   # quick local test runs only; concurrency tests are skipped
